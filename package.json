{
  "name": "gqr-landingpage",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:betriebsanweisung && npm run generate:sitemap && next build",
    "build:github-pages": "npm run build:sdb-preview && npm run validate:betriebsanweisung && npm run generate:sitemap && next build && node scripts/sync-github-pages.mjs",
    "validate:betriebsanweisung": "npx tsx scripts/validate-betriebsanweisung-entries.ts",
    "generate:sitemap": "npx tsx scripts/generate-sitemap.ts",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "build:css": "tailwindcss -i ./src/tw-input.css -o ./tw.css --minify",
    "build:feature-accordion": "node scripts/build-feature-accordion.mjs",
    "build:sdb-preview": "node scripts/build-sdb-preview.mjs",
    "verify:sdb-preview": "node scripts/verify-sdb-preview.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "sync:home-faq-jsonld": "npx tsx scripts/sync-home-faq-jsonld.ts",
    "generate:kfz-werkstatt-landing": "node scripts/generate-kfz-werkstatt-landing.mjs",
    "watch:css": "tailwindcss -i ./src/tw-input.css -o ./tw.css --watch"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "next-mdx-remote": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
